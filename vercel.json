{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "public",
  "headers": [
    {
      "headers": [
        {
          "value": "frame-ancestors 'none'",
          "key": "Content-Security-Policy"
        },
        {
          "value": "DENY",
          "key": "X-Frame-Options"
        },
        {
          "value": "nosniff",
          "key": "X-Content-Type-Options"
        },
        {
          "value": "no-referrer",
          "key": "Referrer-Policy"
        }
      ],
      "source": "/(.*)"
    }
  ]
}
